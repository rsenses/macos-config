#!/usr/bin/env bash
set -euo pipefail

# Rutas operativas. Las variables DEV_* existen para poder ejecutar este
# script en un entorno aislado (pruebas); sin ellas el comportamiento es el
# de siempre: $HOME/dev/caddy-sites, /tmp/dev y el Caddyfile de Homebrew.
SITES_DIR="${DEV_SITES_DIR:-$HOME/dev/caddy-sites}"
CADDYFILE="${DEV_CADDYFILE:-/opt/homebrew/etc/Caddyfile}"
CADDY_ADMIN="${DEV_CADDY_ADMIN:-http://localhost:2019}"
STATE_PREFIX="${DEV_STATE_PREFIX:-/tmp/dev}"
LOCK_DIR="${DEV_LOCK_DIR:-${STATE_PREFIX}.lock}"
LOCK_OWNER_FILE="$LOCK_DIR/owner"
LOCK_HELD=0
PORT_START=8000
PORT_END=8999

PROJECT_DIR=""
PROJECT_ID=""
REPO_NAME=""
DOMAIN=""
SNIPPET=""
CONFIG_FILE=""
WEB_ROOT=""
PORT=""
PHP_LOG_FILE=""
PHP_STATE_FILE=""
declare -a ALIASES=()
declare -a HOSTS=()
declare -a DOMAIN_CONFLICTS=()

usage() {
  echo "Uso:"
  echo "  dev up [nombre_carpeta]"
  echo "  dev down [nombre_carpeta]"
  echo "  dev reload [nombre_carpeta]"
  echo "  dev status [nombre_carpeta]"
  echo "  dev down-all"
  exit 1
}

cmd="${1:-}"
name="${2:-}"

trim() {
  local s="$1"
  s="${s#"${s%%[![:space:]]*}"}"
  s="${s%"${s##*[![:space:]]}"}"
  printf '%s' "$s"
}

port_is_listening() {
  local p="$1"
  lsof -nP -iTCP:"$p" -sTCP:LISTEN >/dev/null 2>&1
}

find_free_port() {
  local candidate="$PORT_START"

  while (( candidate <= PORT_END )); do
    if ! port_is_listening "$candidate"; then
      printf '%s\n' "$candidate"
      return 0
    fi
    candidate=$((candidate + 1))
  done

  echo "Error: no hay puertos libres entre $PORT_START y $PORT_END." >&2
  return 1
}

release_mutation_lock() {
  local owner=""

  (( LOCK_HELD == 1 )) || return 0
  owner="$(cat "$LOCK_OWNER_FILE" 2>/dev/null || true)"
  if [[ "$owner" == "$BASHPID" ]]; then
    rm -f -- "$LOCK_OWNER_FILE"
    rmdir -- "$LOCK_DIR" 2>/dev/null || true
  fi
  LOCK_HELD=0
}

acquire_mutation_lock() {
  local owner=""
  local attempts=0

  (( LOCK_HELD == 1 )) && return 0
  mkdir -p -- "$(dirname "$LOCK_DIR")"

  while ! mkdir -- "$LOCK_DIR" 2>/dev/null; do
    owner="$(cat "$LOCK_OWNER_FILE" 2>/dev/null || true)"
    if [[ "$owner" =~ ^[0-9]+$ ]] && ! kill -0 "$owner" >/dev/null 2>&1; then
      # A crashed invocation can leave the directory behind. Remove it only
      # when its recorded owner is definitely gone; never steal an unknown lock.
      rm -f -- "$LOCK_OWNER_FILE"
      rmdir -- "$LOCK_DIR" 2>/dev/null || true
      continue
    fi

    if (( attempts >= 200 )); then
      echo "Error: otra operación de dev mantiene el bloqueo ${LOCK_DIR}." >&2
      return 1
    fi
    sleep 0.05
    attempts=$((attempts + 1))
  done

  if ! printf '%s\n' "$BASHPID" > "$LOCK_OWNER_FILE"; then
    rmdir -- "$LOCK_DIR" 2>/dev/null || true
    echo "Error: no pude crear el propietario del bloqueo ${LOCK_DIR}." >&2
    return 1
  fi

  LOCK_HELD=1
  trap release_mutation_lock EXIT
}

hash_path() {
  local path="$1"

  if command -v shasum >/dev/null 2>&1; then
    printf '%s' "$path" | shasum -a 256 | awk '{print $1}'
  elif command -v sha256sum >/dev/null 2>&1; then
    printf '%s' "$path" | sha256sum | awk '{print $1}'
  else
    echo "Error: necesito shasum o sha256sum para identificar el proyecto." >&2
    return 1
  fi
}

wait_for_port() {
  local p="$1"
  local timeout_sec="${2:-8}"
  local owner_pid="${3:-}"
  local owner_start="${4:-}"
  local elapsed=0

  while (( elapsed < timeout_sec * 10 )); do
    if port_is_listening "$p"; then
      # An occupied port is not enough: during the find/start race it could
      # belong to another process. When an owner is supplied, wait only for a
      # PHP listener belonging to the process we just started.
      if [[ -z "$owner_pid" ]] || port_listener_belongs_to "$p" "$owner_pid" "$owner_start"; then
        return 0
      fi
    fi
    sleep 0.1
    elapsed=$((elapsed + 1))
  done

  return 1
}

resolve_project() {
  local target_dir=""

  if [[ -n "$name" ]]; then
    if [[ -d "$HOME/dev/www/$name" ]]; then
      target_dir="$HOME/dev/www/$name"
    elif [[ -d "$name" ]]; then
      target_dir="$(cd "$name" && pwd -P)"
    else
      echo "Error: no existe el proyecto '$name'" >&2
      exit 1
    fi
  else
    target_dir="$(pwd -P)"
  fi

  if git -C "$target_dir" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    local repo_root
    local git_common

    repo_root="$(git -C "$target_dir" rev-parse --show-toplevel)"
    repo_root="$(cd "$repo_root" && pwd -P)"
    git_common="$(git -C "$target_dir" rev-parse --git-common-dir)"

    if [[ "$git_common" != /* ]]; then
      git_common="$(cd "$repo_root" && cd "$git_common" && pwd)"
    else
      git_common="$(cd "$git_common" && pwd)"
    fi

    PROJECT_DIR="$repo_root"
    REPO_NAME="$(basename "$(dirname "$git_common")")"
  else
    PROJECT_DIR="$target_dir"
    REPO_NAME="$(basename "$target_dir")"
  fi

  DOMAIN="${REPO_NAME}.test"
  SNIPPET="$SITES_DIR/${REPO_NAME}.caddy"
  CONFIG_FILE="$PROJECT_DIR/.config/caddy"
  WEB_ROOT="$PROJECT_DIR"
  PROJECT_ID="$(hash_path "$PROJECT_DIR")"
  PHP_STATE_FILE="${STATE_PREFIX}-${PROJECT_ID}.state"
  PHP_LOG_FILE="${STATE_PREFIX}-${PROJECT_ID}.log"

  if [[ -d "$PROJECT_DIR/public" ]]; then
    WEB_ROOT="$PROJECT_DIR/public"
  elif [[ -d "$PROJECT_DIR/web" ]]; then
    WEB_ROOT="$PROJECT_DIR/web"
  fi
}

append_alias_if_missing() {
  local candidate="$1"
  local existing

  [[ -n "$candidate" ]] || return 0

  for existing in "${ALIASES[@]-}"; do
    if [[ "$existing" == "$candidate" ]]; then
      return 0
    fi
  done

  ALIASES+=("$candidate")
}

normalize_alias_host() {
  local host="$1"

  host="$(trim "$host")"
  [[ -n "$host" ]] || return 0

  case "$host" in
    *.test) printf '%s\n' "$host" ;;
    *) printf '%s.test\n' "$host" ;;
  esac
}

load_alias_values() {
  local value="$1"
  local token

  value="$(trim "$value")"

  case "$value" in
    '"'*) value="${value#\"}"; value="${value%\"}" ;;
    "'"*) value="${value#\'}"; value="${value%\'}" ;;
  esac

  value="${value//,/ }"
  for token in $value; do
    append_alias_if_missing "$(normalize_alias_host "$token")"
  done
}

load_project_config() {
  ALIASES=()

  if [[ -f "$CONFIG_FILE" ]]; then
    while IFS= read -r raw; do
      local line
      local value

      line="$(trim "${raw%%#*}")"
      [[ -z "$line" ]] && continue

      case "$line" in
        [Aa][Ll][Ii][Aa][Ss][Ee][Ss]=*)
          value="${line#*=}"
          load_alias_values "$value"
          ;;
      esac
    done < "$CONFIG_FILE"
  fi

  HOSTS=("$DOMAIN")
  local alias
  for alias in "${ALIASES[@]-}"; do
    [[ -z "$alias" ]] || HOSTS+=("$alias")
  done
}

pick_port() {
  PORT="$(find_free_port)"
}

write_snippet() {
  if ! mkdir -p "$SITES_DIR"; then
    echo "Error: no pude crear el directorio de snippets ${SITES_DIR}." >&2
    return 1
  fi

  # Une hosts con espacios (site labels múltiples)
  local host_line
  host_line="$(printf "%s " "${HOSTS[@]}")"
  host_line="${host_line% }"

  local temp_file="${SNIPPET}.tmp.$$"

  if ! cat > "$temp_file" <<SNIP
${host_line} {
  tls {
    issuer internal {
      lifetime 7d
    }
  }
reverse_proxy 127.0.0.1:${PORT} {
  header_up Host {host}
  header_up X-Forwarded-Proto https
}
}
SNIP
  then
    rm -f "$temp_file"
    echo "Error: no pude escribir el snippet de Caddy ${SNIPPET}." >&2
    return 1
  fi

  if ! mv -f "$temp_file" "$SNIPPET"; then
    rm -f "$temp_file"
    echo "Error: no pude publicar el snippet de Caddy ${SNIPPET}." >&2
    return 1
  fi
}

caddy_admin_reachable() {
  curl -fsS "${CADDY_ADMIN}/config/" >/dev/null 2>&1
}

caddy_run() {
  local subcmd="$1"
  shift

  if caddy "$subcmd" "$@" >/dev/null 2>&1; then
    return 0
  fi

  if sudo caddy "$subcmd" "$@" >/dev/null 2>&1; then
    return 0
  fi

  echo "Error: no pude ejecutar 'caddy $subcmd'." >&2
  echo "Prueba con 'sudo -v' o ejecuta 'sudo dev up' una vez para autorizar Caddy." >&2
  return 1
}

caddy_reload() {
  caddy_run reload --force --config "$CADDYFILE" --adapter caddyfile
}

caddy_start() {
  caddy_run start --config "$CADDYFILE" --adapter caddyfile
}

reload_caddy() {
  local start_if_needed="${1:-no}"

  if ! caddy_admin_reachable; then
    if [[ "$start_if_needed" == "yes" ]]; then
      caddy_start || return 1
    else
      return 0
    fi
  fi

  caddy_reload
}

# Retira del disco los snippets gestionados por esta herramienta que publican
# el upstream 127.0.0.1:<puerto>. Solo se tocan *.caddy dentro de SITES_DIR y
# solo si contienen la marca exacta del upstream; nunca otros archivos.
purge_snippets_for_port() {
  local port="$1"
  local snippet_file

  [[ "$port" =~ ^[0-9]+$ ]] || return 0

  for snippet_file in "$SITES_DIR"/*.caddy; do
    [[ -f "$snippet_file" ]] || continue
    if grep -qF "reverse_proxy 127.0.0.1:${port} " "$snippet_file" 2>/dev/null; then
      rm -f "$snippet_file"
      printf 'Snippet retirado: %s\n' "$snippet_file" >&2
    fi
  done

  return 0
}

# Retira el snippet nominal de un proyecto si su primera línea (los hosts)
# menciona el dominio principal; evita borrar ficheros ajenos con el mismo nombre.
purge_snippet_for_host() {
  local snippet_file="$1"
  local host="$2"
  local first_line=""

  [[ -n "$host" && -f "$snippet_file" ]] || return 0

  first_line="$(head -n 1 "$snippet_file" 2>/dev/null)" || first_line=""
  # Hosts are space-separated on the generated first line. Match a complete
  # host token instead of a substring such as `api.test` in `my-api.test`.
  if [[ " $first_line " == *" $host "* ]]; then
    rm -f "$snippet_file"
    printf 'Snippet retirado: %s\n' "$snippet_file" >&2
  fi

  return 0
}

read_state_value() {
  local key="$1"
  local state_file="$2"
  local line

  [[ -f "$state_file" ]] || return 1

  while IFS= read -r line; do
    case "$line" in
      "${key}="*)
        printf '%s\n' "${line#*=}"
        return 0
        ;;
    esac
  done < "$state_file"

  return 1
}

# Hora de arranque del proceso (ps lstart) con un pequeño reintento: nada
# después de un fork puede tardar un instante en aparecer en la tabla de
# procesos. Si al final no se puede leer, se guarda vacío y la identidad se
# comprobará solo por comando y puerto.
ps_command_for_pid() {
  ps -ww -p "$1" -o command= 2>/dev/null
}

ps_start_for_pid() {
  ps -ww -p "$1" -o lstart= 2>/dev/null
}

ps_state_for_pid() {
  ps -ww -p "$1" -o state= 2>/dev/null
}

ps_parent_for_pid() {
  ps -ww -p "$1" -o ppid= 2>/dev/null | tr -d '[:space:]'
}

# El comando registrado debe coincidir con un servidor PHP de este puerto:
# `php artisan serve ... --port=<puerto>` o `php -S 127.0.0.1:<puerto> ...`.
php_command_matches() {
  local command_line="$1"
  local port="$2"

  case "$port" in
    ''|*[!0-9]*) return 1 ;;
  esac

  case "$command_line" in
    *"artisan serve"*)
      case "$command_line" in
        *"--port=$port "*|*"--port=$port") return 0 ;;
      esac
      ;;
    *"php -S 127.0.0.1:$port "*|*"php -S 127.0.0.1:$port")
      return 0
      ;;
  esac

  return 1
}

# Un PID solo se considera "nuestro" si su comando coincide con el servidor
# PHP del puerto registrado y, cuando se guardó la hora de arranque, esta
# coincide también. Así un PID reciclado por otro proceso nunca recibe señales.
php_pid_belongs() {
  local pid="$1"
  local port="$2"
  local expected_start="$3"
  local actual_command=""
  local actual_start=""

  [[ "$pid" =~ ^[0-9]+$ ]] || return 1
  (( 10#$pid > 1 )) || return 1
  [[ "$port" =~ ^[0-9]+$ ]] || return 1
  (( 10#$port >= 1 && 10#$port <= 65535 )) || return 1

  actual_command="$(ps_command_for_pid "$pid")" || return 1
  [[ -n "$actual_command" ]] || return 1
  php_command_matches "$actual_command" "$port" || return 1

  if [[ -n "$expected_start" ]]; then
    actual_start="$(ps_start_for_pid "$pid")" || return 1
    [[ "$actual_start" == "$expected_start" ]] || return 1
  fi

  return 0
}

port_listener_pid() {
  local port="$1"

  lsof -nP -t -iTCP:"$port" -sTCP:LISTEN 2>/dev/null | head -n 1
}

# Verify the listener after starting PHP. This prevents a process that wins the
# find-free-port race from being published behind the new Caddy route.
port_listener_belongs_to() {
  local port="$1"
  local owner_pid="$2"
  local owner_start="${3:-}"
  local listener_pid=""

  listener_pid="$(port_listener_pid "$port")" || listener_pid=""
  [[ "$listener_pid" =~ ^[0-9]+$ ]] || return 1
  process_is_descendant_of "$listener_pid" "$owner_pid" || return 1

  if [[ "$listener_pid" == "$owner_pid" ]]; then
    php_pid_belongs "$listener_pid" "$port" "$owner_start"
  else
    php_pid_belongs "$listener_pid" "$port" ""
  fi
}

write_php_state() {
  local pid="$1"
  local hosts_line
  local pid_start=""
  local tries=0
  local temp_file="${PHP_STATE_FILE}.tmp.$$"

  hosts_line="$(printf "%s " "${HOSTS[@]}")"
  hosts_line="${hosts_line% }"

  while [[ -z "$pid_start" ]] && (( tries < 5 )); do
    pid_start="$(ps_start_for_pid "$pid")" || pid_start=""
    if [[ -z "$pid_start" ]]; then
      sleep 0.1
      tries=$((tries + 1))
    fi
  done

  {
    printf 'PROJECT_DIR=%s\n' "$PROJECT_DIR"
    printf 'DOMAIN=%s\n' "$DOMAIN"
    printf 'HOSTS=%s\n' "$hosts_line"
    printf 'PORT=%s\n' "$PORT"
    printf 'PID=%s\n' "$pid"
    printf 'PID_START=%s\n' "$pid_start"
  } > "$temp_file"

  mv -f "$temp_file" "$PHP_STATE_FILE"
}

start_php_server() {
  mkdir -p "$(dirname "$PHP_LOG_FILE")"
  : > "$PHP_LOG_FILE"

  mkdir -p "$(dirname "$PHP_STATE_FILE")"

  local -a server_command
  local server_workdir="$PROJECT_DIR"
  if [[ -f "$PROJECT_DIR/artisan" ]]; then
    server_command=(php artisan serve --host=127.0.0.1 --port="${PORT}")
  elif [[ -f "$WEB_ROOT/index.php" ]]; then
    # Drupal resuelve algunos servicios con rutas relativas a su docroot.
    # El servidor debe arrancar desde web/ para que core/core.services.yml
    # apunte a web/core/core.services.yml.
    server_workdir="$WEB_ROOT"
    server_command=(php -S "127.0.0.1:${PORT}" -t "$WEB_ROOT")
    if [[ -f "$WEB_ROOT/.ht.router.php" ]]; then
      server_command+=("$WEB_ROOT/.ht.router.php")
    fi
  else
    echo "Error: no encuentro un entrypoint PHP (artisan o index.php) en ${PROJECT_DIR}." >&2
    return 1
  fi

  (
    cd "$server_workdir"

    if [[ -f "$PROJECT_DIR/artisan" ]]; then
      # direnv u otras herramientas pueden exportar el placeholder sin resolver.
      # Laravel no sobreescribe una APP_URL heredada y Symfony la rechaza.
      case "${APP_URL:-}" in
        *\$*) unset APP_URL ;;
      esac
    fi

    nohup "${server_command[@]}" >"$PHP_LOG_FILE" 2>&1 < /dev/null &
    local server_pid="$!"

    # Si el estado no se puede guardar, el servidor quedaría huérfano y sin
    # control: se mata y se propaga el error antes de publicar el upstream.
    if ! write_php_state "$server_pid"; then
      kill "$server_pid" >/dev/null 2>&1 || true
      echo "Error: no pude registrar el estado del servidor PHP." >&2
      exit 1
    fi
  )
}

show_php_log() {
  if [[ -f "$PHP_LOG_FILE" ]]; then
    tail -n 40 "$PHP_LOG_FILE" >&2 || true
  else
    echo "Log no encontrado: $PHP_LOG_FILE" >&2
  fi
}

load_php_state() {
  local state_project
  local state_port

  state_project="$(read_state_value PROJECT_DIR "$PHP_STATE_FILE" 2>/dev/null)" || return 1
  [[ "$state_project" == "$PROJECT_DIR" ]] || return 1

  state_port="$(read_state_value PORT "$PHP_STATE_FILE" 2>/dev/null)" || return 1
  [[ "$state_port" =~ ^[0-9]+$ ]] || return 1
  (( state_port >= 1 && state_port <= 65535 )) || return 1

  PORT="$state_port"
}

read_php_pid() {
  local pid=""

  pid="$(read_state_value PID "$PHP_STATE_FILE" 2>/dev/null)" || return 1
  [[ -n "$pid" && "$pid" =~ ^[0-9]+$ ]] || return 1
  printf '%s\n' "$pid"
}

php_pid_is_running() {
  local pid="$1"
  local process_state=""

  [[ "$pid" =~ ^[0-9]+$ ]] || return 1
  process_state="$(ps_state_for_pid "$pid" 2>/dev/null || true)"
  # `kill -0` also succeeds for a zombie on macOS until its parent reaps it.
  [[ "$process_state" != Z* ]] || return 1
  kill -0 "$pid" >/dev/null 2>&1
}

# Returns success only when child_pid is the listener itself or a descendant of
# owner_pid. This covers artisan's child `php -S` without ever killing another
# PHP process that merely happens to use the same port.
process_is_descendant_of() {
  local child_pid="$1"
  local owner_pid="$2"
  local parent_pid=""
  local depth=0

  [[ "$child_pid" =~ ^[0-9]+$ && "$owner_pid" =~ ^[0-9]+$ ]] || return 1
  [[ "$child_pid" == "$owner_pid" ]] && return 0

  while (( depth < 32 )); do
    parent_pid="$(ps_parent_for_pid "$child_pid" 2>/dev/null || true)"
    [[ "$parent_pid" =~ ^[0-9]+$ ]] || return 1
    [[ "$parent_pid" == "$owner_pid" ]] && return 0
    [[ "$parent_pid" != 0 && "$parent_pid" != 1 && "$parent_pid" != "$child_pid" ]] || return 1
    child_pid="$parent_pid"
    depth=$((depth + 1))
  done

  return 1
}

stop_process() {
  local pid="$1"
  local attempts=0

  php_pid_is_running "$pid" || return 0

  kill "$pid" >/dev/null 2>&1 || true

  while php_pid_is_running "$pid" && (( attempts < 10 )); do
    sleep 0.1
    attempts=$((attempts + 1))
  done

  if php_pid_is_running "$pid"; then
    kill -9 "$pid" >/dev/null 2>&1 || true
    sleep 0.1
  fi

  ! php_pid_is_running "$pid"
}

# Último recurso conservador: si el puerto sigue ocupado tras parar al PID
# registrado (p. ej. el hijo `php -S` de `artisan serve`), solo se detiene al
# ocupante si su comando coincide con un servidor PHP en ese puerto concreto.
stop_port_listener_if_ours() {
  local port="$1"
  local owner_pid="${2:-}"
  local listener_pid=""

  [[ "$port" =~ ^[0-9]+$ ]] || return 0
  [[ "$owner_pid" =~ ^[0-9]+$ ]] || return 0
  port_is_listening "$port" || return 0

  listener_pid="$(port_listener_pid "$port")" || listener_pid=""

  if [[ ! "$listener_pid" =~ ^[0-9]+$ ]]; then
    echo "Aviso: el puerto ${port} sigue ocupado y no pude identificar al proceso que lo escucha." >&2
    return 1
  fi

  if ! process_is_descendant_of "$listener_pid" "$owner_pid"; then
    echo "Aviso: el puerto ${port} sigue ocupado por un proceso fuera de este servidor; no se detiene." >&2
    return 1
  fi

  if ! php_pid_belongs "$listener_pid" "$port" ""; then
    echo "Aviso: el puerto ${port} sigue ocupado por el PID ${listener_pid}, que no parece un servidor PHP de este proyecto; no se detiene." >&2
    return 1
  fi

  stop_process "$listener_pid" || true

  if port_is_listening "$port"; then
    echo "Aviso: el puerto ${port} sigue ocupado tras detener al PID ${listener_pid}." >&2
    return 1
  fi

  return 0
}

# Para el servidor descrito por un archivo de estado y limpia ese estado.
# Nunca se señaliza un PID solo porque exista: se exige identidad
# (comando + puerto, y hora de arranque si se registró). Si el PID está vivo
# pero no se puede verificar, se avisa y se devuelve error sin matarlo.
stop_state_file() {
  local state_file="$1"
  local pid=""
  local port=""
  local start=""
  local status=0

  port="$(read_state_value PORT "$state_file" 2>/dev/null)" || port=""
  pid="$(read_state_value PID "$state_file" 2>/dev/null)" || pid=""

  if [[ "$pid" =~ ^[0-9]+$ ]] && php_pid_is_running "$pid"; then
    start="$(read_state_value PID_START "$state_file" 2>/dev/null)" || start=""
    if php_pid_belongs "$pid" "$port" "$start"; then
      # Stop artisan's listener while it is still a descendant. Once the
      # parent exits macOS may reparent the child, so discovering it only
      # afterwards would leave the PHP listener alive.
      if ! stop_port_listener_if_ours "$port" "$pid"; then
        status=1
      fi
      if ! stop_process "$pid"; then
        echo "Aviso: no pude terminar el PID ${pid}." >&2
        status=1
      fi
    else
      echo "Aviso: el PID ${pid} del estado ${state_file} no corresponde a un servidor PHP de este proyecto (¿PID reutilizado?); no se detiene." >&2
      status=1
    fi
  fi

  stop_port_listener_if_ours "$port" "$pid" || status=1

  rm -f "$state_file"

  return "$status"
}

hosts_overlap() {
  local other_hosts="$1"
  local current_host
  local other_host

  for current_host in "${HOSTS[@]-}"; do
    for other_host in $other_hosts; do
      if [[ "$current_host" == "$other_host" ]]; then
        return 0
      fi
    done
  done

  return 1
}

find_domain_conflicts() {
  DOMAIN_CONFLICTS=()

  local state_file
  local other_pid
  local other_hosts

  for state_file in "${STATE_PREFIX}"-*.state; do
    [[ -f "$state_file" ]] || continue
    [[ "$state_file" == "$PHP_STATE_FILE" ]] && continue

    if ! other_pid="$(read_state_value PID "$state_file" 2>/dev/null)"; then
      continue
    fi
    [[ "$other_pid" =~ ^[0-9]+$ ]] || continue

    if ! php_pid_is_running "$other_pid"; then
      rm -f "$state_file"
      continue
    fi

    if ! other_hosts="$(read_state_value HOSTS "$state_file" 2>/dev/null)"; then
      other_hosts="$(read_state_value DOMAIN "$state_file" 2>/dev/null)" || continue
    fi

    if hosts_overlap "$other_hosts"; then
      DOMAIN_CONFLICTS+=("$state_file")
    fi
  done
}

show_domain_conflicts() {
  local state_file
  local other_project
  local other_port
  local other_pid
  local value

  echo "Ya hay una instancia activa para un dominio de ${DOMAIN}:" >&2
  for state_file in "${DOMAIN_CONFLICTS[@]}"; do
    other_project="(desconocido)"
    other_port="(desconocido)"
    other_pid="(desconocido)"

    if value="$(read_state_value PROJECT_DIR "$state_file" 2>/dev/null)"; then
      other_project="$value"
    fi
    if value="$(read_state_value PORT "$state_file" 2>/dev/null)"; then
      other_port="$value"
    fi
    if value="$(read_state_value PID "$state_file" 2>/dev/null)"; then
      other_pid="$value"
    fi

    printf '  Proyecto: %s\n' "$other_project" >&2
    printf '  Puerto: %s (PID %s)\n' "$other_port" "$other_pid" >&2
  done
}

confirm_domain_replacement() {
  local answer=""

  printf '¿Quieres detener la instancia anterior y lanzar esta? [s/N] ' >&2
  IFS= read -r answer || return 1

  case "$answer" in
    s|S|si|Si|SI|sí|Sí|SÍ|y|Y|yes|Yes|YES)
      return 0
      ;;
    *)
      return 1
      ;;
  esac
}

case "${cmd}" in
  up)
    resolve_project
    load_project_config
    acquire_mutation_lock || exit 1

    routes_changed=0
    find_domain_conflicts
    if (( ${#DOMAIN_CONFLICTS[@]} > 0 )); then
      show_domain_conflicts
      if ! confirm_domain_replacement; then
        echo "Cancelado: se mantiene la instancia anterior." >&2
        exit 1
      fi

      for state_file in "${DOMAIN_CONFLICTS[@]}"; do
        conflict_port="$(read_state_value PORT "$state_file" 2>/dev/null)" || conflict_port=""
        conflict_dir="$(read_state_value PROJECT_DIR "$state_file" 2>/dev/null)" || conflict_dir=""
        conflict_domain="$(read_state_value DOMAIN "$state_file" 2>/dev/null)" || conflict_domain=""
        purge_snippets_for_port "$conflict_port"
        if [[ -n "$conflict_dir" && -n "$conflict_domain" ]]; then
          purge_snippet_for_host "$SITES_DIR/$(basename "$conflict_dir").caddy" "$conflict_domain"
        fi
        if ! stop_state_file "$state_file"; then
          echo "Error: no pude detener por completo la instancia en conflicto." >&2
          exit 1
        fi
        routes_changed=1
      done
    fi

    # Remove the previous route before stopping/replacing its server. If Caddy
    # is reachable, a failed reload aborts instead of leaving an old route in
    # memory while this command continues with a new port.
    if [[ -f "$PHP_STATE_FILE" || -f "$SNIPPET" ]]; then
      old_port="$(read_state_value PORT "$PHP_STATE_FILE" 2>/dev/null || true)"
      purge_snippets_for_port "$old_port"
      purge_snippet_for_host "$SNIPPET" "$DOMAIN"
      routes_changed=1
    fi

    if (( routes_changed )) && caddy_admin_reachable; then
      caddy_reload || {
        echo "Error: no pude retirar las rutas antiguas de Caddy." >&2
        exit 1
      }
    fi

    if ! stop_state_file "$PHP_STATE_FILE"; then
      echo "Error: no pude detener por completo la instancia anterior." >&2
      exit 1
    fi
    pick_port

    if port_is_listening "$PORT"; then
      echo "Error: puerto $PORT ocupado para ${DOMAIN}." >&2
      echo "Sugerencia: revisa el proceso con 'lsof -nP -iTCP:$PORT -sTCP:LISTEN'" >&2
      exit 1
    fi

    # Retira snippets antiguos que publiquen este puerto para que ningún
    # dominio viejo siga sirviendo el proyecto nuevo tras la recarga.
    purge_snippets_for_port "$PORT"

    # Arranca PHP antes de publicar el nuevo upstream para que Caddy no
    # pueda enviar peticiones a un puerto todavía vacío.
    start_php_server
    if ! wait_for_port "$PORT" 10 \
        "$(read_state_value PID "$PHP_STATE_FILE" 2>/dev/null || true)" \
        "$(read_state_value PID_START "$PHP_STATE_FILE" 2>/dev/null || true)"; then
      stop_state_file "$PHP_STATE_FILE" || true
      reload_caddy no || true
      echo "Error: PHP no quedó escuchando en el puerto $PORT para ${DOMAIN}." >&2
      show_php_log
      exit 1
    fi

    if ! write_snippet; then
      # El servidor ya está controlado por un estado; no lo dejes huérfano si
      # falla la publicación del snippet.
      stop_state_file "$PHP_STATE_FILE" || true
      reload_caddy no || true
      echo "Error: no pude escribir el snippet de Caddy para ${DOMAIN}." >&2
      exit 1
    fi

    if ! reload_caddy yes; then
      rm -f "$SNIPPET"
      # Mejor esfuerzo: saca el snippet recién escrito de la config en memoria.
      reload_caddy no || true
      stop_state_file "$PHP_STATE_FILE" || true
      echo "Error: no pude recargar Caddy para ${DOMAIN}." >&2
      exit 1
    fi

    echo "OK: https://${DOMAIN}  ->  127.0.0.1:${PORT} (${PROJECT_DIR})"
    echo "Log: $PHP_LOG_FILE"
    ;;

  down)
    resolve_project
    acquire_mutation_lock || exit 1

    down_status=0
    state_port="$(read_state_value PORT "$PHP_STATE_FILE" 2>/dev/null)" || state_port=""

    # Retira los snippets de este proyecto antes de recargar, para que Caddy
    # deje de publicar el dominio en cuanto se confirma la recarga.
    purge_snippets_for_port "$state_port"
    purge_snippet_for_host "$SNIPPET" "$DOMAIN"

    if caddy_admin_reachable; then
      caddy_reload || down_status=1
    else
      echo "Aviso: Caddy no está en ejecución; el snippet de ${DOMAIN} se ha retirado del disco." >&2
    fi

    stop_state_file "$PHP_STATE_FILE" || down_status=1

    if (( down_status == 0 )); then
      echo "OK: parado ${DOMAIN}"
    else
      echo "Error: no pude detener ${DOMAIN} por completo; revisa los avisos." >&2
      exit 1
    fi
    ;;

  reload)
    # Do not start a replacement while the old route/process could still be
    # active: a failed down must remain visible to the caller.
    if ! "$0" down "${name:-}"; then
      echo "Error: no se inicia el reemplazo porque 'down' no terminó correctamente." >&2
      exit 1
    fi
    "$0" up "${name:-}"
    ;;

  status)
    resolve_project
    load_project_config

    echo "Proyecto: $REPO_NAME"
    echo "Ruta actual: $PROJECT_DIR"
    echo "Dominio: $DOMAIN"
    if [[ -f "$CONFIG_FILE" ]]; then
      echo "Config: $CONFIG_FILE"
    else
      echo "Config: (sin .config/caddy)"
    fi

    if load_php_state; then
      echo "Puerto: $PORT"
      state_start="$(read_state_value PID_START "$PHP_STATE_FILE" 2>/dev/null)" || state_start=""
      if pid="$(read_php_pid 2>/dev/null)" && php_pid_is_running "$pid"; then
        if php_pid_belongs "$pid" "$PORT" "$state_start"; then
          echo "Servidor PHP: activo en 127.0.0.1:$PORT"
        else
          echo "Servidor PHP: el PID $pid está vivo pero no corresponde a este proyecto (¿PID reutilizado?)"
        fi
      else
        echo "Servidor PHP: inactivo"
      fi
    else
      PORT=""
      echo "Puerto: (sin asignar)"
      echo "Servidor PHP: inactivo"
    fi

    echo "Log: $PHP_LOG_FILE"
    show_php_log
    ;;

  down-all)
    acquire_mutation_lock || exit 1
    echo "Parando todos los proyectos..."

    down_status=0
    down_any=0
    for state_file in "${STATE_PREFIX}"-*.state; do
      [[ -f "$state_file" ]] || continue
      down_any=1
      state_port="$(read_state_value PORT "$state_file" 2>/dev/null)" || state_port=""
      state_dir="$(read_state_value PROJECT_DIR "$state_file" 2>/dev/null)" || state_dir=""
      state_domain="$(read_state_value DOMAIN "$state_file" 2>/dev/null)" || state_domain=""
      purge_snippets_for_port "$state_port"
      if [[ -n "$state_dir" && -n "$state_domain" ]]; then
        purge_snippet_for_host "$SITES_DIR/$(basename "$state_dir").caddy" "$state_domain"
      fi
    done

    if (( down_any )); then
      if caddy_admin_reachable; then
        caddy_reload || down_status=1
      else
        echo "Aviso: Caddy no está en ejecución; los snippets se han retirado del disco." >&2
      fi
    fi

    for state_file in "${STATE_PREFIX}"-*.state; do
      [[ -f "$state_file" ]] || continue
      stop_state_file "$state_file" || down_status=1
    done

    echo "OK: todos los servidores PHP detenidos"
    (( down_status == 0 )) || exit 1
    ;;

  *)
    usage
    ;;
esac
