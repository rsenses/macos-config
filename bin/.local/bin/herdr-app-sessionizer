#!/usr/bin/env bash
set -euo pipefail

for cmd in zoxide fzf git jq herdr-app; do
  command -v "$cmd" >/dev/null 2>&1 || { printf 'Falta el comando: %s\n' "$cmd" >&2; exit 1; }
done

project="$(zoxide query -l | awk '!seen[$0]++' | fzf --height=100% --layout=reverse --border=none --no-multi --prompt='project > ' --preview='' --preview-window=hidden)" || exit 0
[ -n "$project" ] || exit 0

dir="$project"
if git -C "$project" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  worktrees="$(git -C "$project" worktree list --porcelain | awk '/^worktree / { print substr($0, 10) }')"
  if [ "$(printf '%s\n' "$worktrees" | awk 'NF { n++ } END { print n+0 }')" -gt 1 ]; then
    dir="$(printf '%s\n' "$worktrees" | awk '{ n=split($0, parts, "/"); print parts[n] "\t" $0 }' | fzf --height=100% --layout=reverse --border=none --no-multi --prompt='worktree > ' --delimiter=$'\t' --with-nth=1 --preview='' --preview-window=hidden)" || exit 0
    [ -n "$dir" ] || exit 0
    dir="${dir#*$'\t'}"
  fi
fi
dir="$(cd "$dir" && pwd -P)"

spaces="$(herdr-app ls)"
id="$(printf '%s' "$spaces" | jq -r --arg dir "$dir" '[.spaces[] | select(.machine == null and .folder == $dir) | .id][0] // empty')"
if [ -n "$id" ]; then
  herdr-app do space.select --id "$id"
else
  herdr-app do space.new --folder "$dir" --machine ''
fi
