{
  "lastChangelogVersion": "1.1.0",
  "defaultProvider": "openai-codex",
  "defaultModel": "gpt-6-luna",
  "defaultThinkingLevel": "xhigh",
  "modelThinkingLevels": {
    "openai-codex/gpt-6-luna": "xhigh",
    "openai-codex/gpt-6.1-sol": "low",
    "opencode-go/deepseek-v4.1-flash": "high",
    "opencode-go/claude-haiku-5-5": "xhigh"
  },
  "showCacheMissNotices": true,
  "defaultTools": ["+codemode"],
  "shellPath": "/bin/zsh",
  "shellCommandPrefix": "eval \"$(mise env -s zsh)\"\nunset APP_URL APP_ENV",
  "theme": "light",
  "packages": [
    "npm:pi-lsp-bridge@2.3.0",
    "npm:pi-gpt-search@1.1.0",
    "../../dev/contrib/pi-review",
    "npm:@pinet/model-aware-compaction"
  ],
  "enabledModels": [
    "openai-codex/gpt-6-luna",
    "opencode-go/deepseek-v4.1-flash",
    "openai-codex/gpt-6.1-sol",
    "opencode-go/claude-haiku-5-5"
  ],
  "enableInstallTelemetry": false,
  "compaction": {
    "enabled": true,
    "modelOverrides": {
      "opencode-go/claude-haiku-5-5": {
        "reserveTokens": 910000
      },
      "opencode-go/deepseek-v4.1-flash": {
        "reserveTokens": 750000
      }
    }
  },
  "model-aware-compaction": {
    "enabled": false,
    "compactionModel": "openai-codex/gpt-6-luna:low",
    "summaryReserveTokens": 16384
  },
  "npmCommand": ["mise", "exec", "node@24", "--", "npm"]
}
