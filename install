#!/usr/bin/env bash

set -euo pipefail

DOTFILES_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"

ensure_xcode_tools() {
  if xcode-select -p >/dev/null 2>&1; then
    echo "Command Line Tools de Xcode ya están instaladas."
    return 0
  fi

  echo "No encuentro las Command Line Tools de Xcode; abriendo su instalador..."
  sudo xcode-select --install
  if ! xcode-select -p >/dev/null 2>&1; then
    echo "Instala las Command Line Tools y vuelve a ejecutar este script." >&2
    exit 1
  fi
}

ensure_homebrew() {
  if ! command -v brew >/dev/null 2>&1; then
    echo "No encuentro Homebrew; instalándolo..."
    command -v curl >/dev/null 2>&1 || {
      echo "Error: necesito curl para instalar Homebrew." >&2
      exit 1
    }
    /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
  fi

  if ! command -v brew >/dev/null 2>&1; then
    for brew_bin in /opt/homebrew/bin/brew /usr/local/bin/brew; do
      if [[ -x "$brew_bin" ]]; then
        eval "$("$brew_bin" shellenv)"
        break
      fi
    done
  fi

  command -v brew >/dev/null 2>&1 || {
    echo "Error: Homebrew no quedó disponible en PATH." >&2
    exit 1
  }
}

ensure_npm_command() {
  local executable="$1"
  local package="$2"

  if command -v "$executable" >/dev/null 2>&1; then
    return 0
  fi
  command -v npm >/dev/null 2>&1 || {
    echo "Error: necesito npm para instalar ${package}." >&2
    exit 1
  }

  echo "Instalando ${package}..."
  npm install --global --ignore-scripts "$package"
  command -v "$executable" >/dev/null 2>&1 || {
    echo "Error: ${package} se instaló, pero no encuentro ${executable} en PATH." >&2
    exit 1
  }
}

ensure_xcode_tools
ensure_homebrew

echo "Instalando dependencias declaradas en Brewfile..."
brew bundle --file="$DOTFILES_DIR/Brewfile"

# Pi y el servidor LSP de Stylelint se distribuyen como paquetes npm, no como
# dotfiles. --ignore-scripts evita ejecutar scripts de instalación de terceros.
ensure_npm_command pi '@earendil-works/pi-coding-agent'
ensure_npm_command stylelint-language-server '@stylelint/language-server'

# Enlaza solo paquetes que existen en este repositorio. Las rutas explícitas
# hacen que el script sea independiente del directorio desde el que se ejecuta.
stow_packages=(
  bin
  git
  ghostty
  herdr
  nvim
  phpactor
  pi
  ripgrep
  tmux
  wezterm
  worktrunk
  yazi
  zsh
)

for package in "${stow_packages[@]}"; do
  stow --dir="$DOTFILES_DIR" --target="$HOME" --restow "$package"
done

echo "Instalación completada."
